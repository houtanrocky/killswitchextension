{
  "name": "kill-switch-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "test": "vitest run --configLoader native --pool threads --maxWorkers 1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:firefox"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
