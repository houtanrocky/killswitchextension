<Window x:Class="KillSwitch.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kill Switch" Height="720" Width="1040" MinHeight="560" MinWidth="820"
        Icon="/KillSwitch.Companion;component/Assets/killswitch.png"
        ShowInTaskbar="True"
        Background="#10131A" Foreground="#F4F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263142" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#3B485B" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202735" />
            <Setter Property="Foreground" Value="#B9C3D2" />
            <Setter Property="Padding" Value="10,11" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" Background="#201B25" BorderBrush="#54303A" BorderThickness="1" CornerRadius="13" Padding="6" Margin="0,0,13,0">
                    <Image Source="/KillSwitch.Companion;component/Assets/killswitch.png" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KILL" FontSize="12" FontWeight="ExtraBold" Foreground="#F06A76" />
                        <TextBlock Text=" SWITCH" FontSize="12" FontWeight="ExtraBold" Foreground="#E8ECF3" />
                        <Border Background="#263142" CornerRadius="4" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WINDOWS COMPANION" FontSize="9" FontWeight="Bold" Foreground="#B9C3D2" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Network access rules" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ImportButton" Content="Import" Click="Import_Click" />
                <Button x:Name="ExportButton" Content="Export" Click="Export_Click" />
                <Button x:Name="RefreshIpButton" Content="Check my IP" Click="RefreshIp_Click" />
                <Button x:Name="AddRuleButton" Content="Add rule" Click="AddRule_Click" />
                <Button x:Name="SaveButton" Content="Save rules" Background="#C94150" BorderBrush="#E45562" Click="Save_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NETWORK FILTER" FontSize="11" FontWeight="Bold" Foreground="#9BA9BC" />
                    <TextBlock x:Name="ProtectionStatus" Text="Not active — Windows egress gate is stopped" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="#FFB45D" />
                    <TextBlock Text="The egress gate blocks direct outbound traffic and allows Kill Switch to reach its gateway." FontSize="12" Foreground="#AAB4C3" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="CURRENT PUBLIC IP" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CurrentIpText" Text="Not checked" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button x:Name="StartProxyButton" Content="Enable Windows egress gate" Click="StartProxy_Click" />
                        <Button x:Name="StopProxyButton" Content="Disable egress gate" IsEnabled="False" Click="StopProxy_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="GATEWAY ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" Margin="0,0,0,5" />
                    <TextBox x:Name="GatewayEndpointInput" Text="https://" Padding="8" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="GATEWAY ACCESS TOKEN" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" Margin="0,0,0,5" />
                    <PasswordBox x:Name="GatewayTokenInput" Padding="8" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="SyncGatewayButton" Content="Save and sync rules" Click="SyncGateway_Click" />
                </StackPanel>
                <TextBlock x:Name="GatewayStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="Gateway not configured" Foreground="#AAB4C3" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="FILTER RULES" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="RuleSearchInput" TextChanged="RuleSearch_TextChanged" ToolTip="Search by domain, page, or IP" Padding="7" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="RulesGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#151A23" Foreground="#F4F6FA"
                  RowBackground="#151A23" AlternatingRowBackground="#191F2A" BorderBrush="#2D394A" BorderThickness="1"
                  HorizontalGridLinesBrush="#27303D" VerticalGridLinesBrush="#151A23" SelectionMode="Single"
                  CanUserReorderColumns="False" CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="WEBSITE OR PAGE" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="IP CONDITIONS" Binding="{Binding IpConditions, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="CURRENT IP STATUS" Binding="{Binding CurrentStatus}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="RulesCountText" Text="0 rules" Foreground="#AAB4C3" VerticalAlignment="Center" />
            <Button x:Name="RemoveRuleButton" Content="Remove selected" DockPanel.Dock="Right" Click="RemoveRule_Click" />
            <Button x:Name="DiscardChangesButton" Content="Discard changes" DockPanel.Dock="Right" Click="DiscardChanges_Click" />
            <TextBlock x:Name="MessageText" Foreground="#AAB4C3" VerticalAlignment="Center" Margin="18,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
