<Window x:Class="KillSwitch.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kill Switch" Height="850" Width="1180" MinHeight="700" MinWidth="980"
        Icon="/KillSwitch.Companion;component/Assets/killswitch.png"
        ShowInTaskbar="True" ResizeMode="CanResize"
        Background="#10131A" Foreground="#F4F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263142" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#3B485B" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202735" />
            <Setter Property="Foreground" Value="#B9C3D2" />
            <Setter Property="Padding" Value="10,11" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <Border Width="48" Height="48" Background="#201B25" BorderBrush="#54303A" BorderThickness="1" CornerRadius="13" Padding="6" Margin="0,0,13,0">
                <Image Source="/KillSwitch.Companion;component/Assets/killswitch.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KILL" FontSize="12" FontWeight="ExtraBold" Foreground="#F06A76" />
                    <TextBlock Text=" SWITCH" FontSize="12" FontWeight="ExtraBold" Foreground="#E8ECF3" />
                    <Border Background="#263142" CornerRadius="4" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WINDOWS COMPANION" FontSize="9" FontWeight="Bold" Foreground="#B9C3D2" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Network access rules" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RULES &amp; CONNECTION" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" />
                <TextBlock Text="Manage your local site blocks and connection settings." FontSize="12" Foreground="#AAB4C3" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ImportButton" Content="Import" Click="Import_Click" />
                <Button x:Name="ExportButton" Content="Export" Click="Export_Click" />
                <Button x:Name="RefreshIpButton" Content="Check my IP" Click="RefreshIp_Click" />
                <Button x:Name="AddRuleButton" Content="Add site to protect" Click="AddRule_Click" />
                <Button x:Name="SaveButton" Content="Save rules" Background="#C94150" BorderBrush="#E45562" Margin="0" Click="Save_Click" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="NETWORK FILTER" FontSize="11" FontWeight="Bold" Foreground="#9BA9BC" />
                    <TextBlock x:Name="ProtectionStatus" Text="Protection is off" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#FFB45D" />
                    <TextBlock Text="When on, Kill Switch routes compatible apps through its service and blocks other outbound connections." FontSize="12" TextWrapping="Wrap" Foreground="#AAB4C3" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock Text="CURRENT PUBLIC IP" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CurrentIpText" Text="Not checked" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    <WrapPanel HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button x:Name="StartProxyButton" Content="Start protection" MinWidth="150" Click="StartProxy_Click" />
                        <Button x:Name="StopProxyButton" Content="Stop protection" MinWidth="130" Margin="0" IsEnabled="False" Click="StopProxy_Click" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="CONNECTION SERVICE" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" />
                    <TextBlock Text="Connects automatically when you turn on protection. No server address or account needed." FontSize="12" TextWrapping="Wrap" Foreground="#D9E0EA" Margin="0,5,0,0" />
                    <TextBlock x:Name="GatewayStatusText" Text="Managed service availability will be checked when protection is enabled." TextWrapping="Wrap" Foreground="#AAB4C3" Margin="0,5,0,0" />
                </StackPanel>
                <CheckBox x:Name="LaunchAtStartupCheck" Grid.Column="1" Content="Open Kill Switch when I sign in" Foreground="#D9E0EA" VerticalAlignment="Center" Checked="LaunchAtStartup_Changed" Unchecked="LaunchAtStartup_Changed" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="MANAGE BLOCKS" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" />
                    <TextBlock Text="Each site is allowed only from its listed IP addresses. Add a site to fill in your current IP automatically." FontSize="10" Foreground="#AAB4C3" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="RuleSearchInput" TextChanged="RuleSearch_TextChanged" ToolTip="Search by site, page path, or IP" MinHeight="38" Padding="8" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <DataGrid x:Name="RulesGrid" Grid.Row="5" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#151A23" Foreground="#F4F6FA"
                  RowBackground="#151A23" AlternatingRowBackground="#191F2A" BorderBrush="#2D394A" BorderThickness="1"
                  HorizontalGridLinesBrush="#27303D" VerticalGridLinesBrush="#151A23" SelectionMode="Single"
                  CanUserReorderColumns="False" CanUserResizeRows="False" MinHeight="160"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SITE OR PAGE TO BLOCK" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="IP RULE" Binding="{Binding IpConditions, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="CURRENT IP STATUS" Binding="{Binding CurrentStatus}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <TextBlock x:Name="RulesCountText" Text="0 rules" Foreground="#AAB4C3" VerticalAlignment="Center" />
            <Button x:Name="RemoveRuleButton" Content="Remove selected" DockPanel.Dock="Right" Click="RemoveRule_Click" />
            <Button x:Name="DiscardChangesButton" Content="Discard changes" DockPanel.Dock="Right" Click="DiscardChanges_Click" />
            <TextBlock x:Name="MessageText" Foreground="#AAB4C3" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
