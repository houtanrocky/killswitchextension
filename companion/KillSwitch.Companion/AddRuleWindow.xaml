<Window x:Class="KillSwitch.Companion.AddRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect a website" Width="560" Height="490" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#10131A" Foreground="#F4F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263142" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#3B485B" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Protect a website" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Choose which IP addresses can reach this site. Your current IP is selected automatically." TextWrapping="Wrap" Foreground="#AAB4C3" Margin="0,8,0,18" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="WEBSITE OR PAGE" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" Margin="0,0,0,6" />
            <TextBox x:Name="TargetInput" MinHeight="42" Padding="10" FontSize="15" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" VerticalContentAlignment="Center" ToolTip="For example: example.com or example.com/private" />
            <TextBlock Text="Enter a domain such as example.com, or a specific page such as example.com/private." TextWrapping="Wrap" FontSize="11" Foreground="#AAB4C3" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="WHAT SHOULD HAPPEN ON THESE IP ADDRESSES?" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" Margin="0,0,0,7" />
            <RadioButton x:Name="AllowIpsRadio" GroupName="IpAction" IsChecked="True" Content="Allow the site only from these IPs" Foreground="#F4F6FA" Margin="0,3" />
            <RadioButton x:Name="BlockIpsRadio" GroupName="IpAction" Content="Block the site from these IPs" Foreground="#F4F6FA" Margin="0,3" />
        </StackPanel>

        <Border Grid.Row="4" Background="#1B222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="YOUR CURRENT PUBLIC IP" FontSize="10" FontWeight="Bold" Foreground="#9BA9BC" />
                <TextBlock x:Name="CurrentIpText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="This address is selected automatically for the rule." FontSize="11" Foreground="#AAB4C3" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="5" Header="Advanced: use different IP addresses" Foreground="#D9E0EA" Margin="0,14,0,0">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="IPv4 addresses (separate multiple addresses with commas)" TextWrapping="Wrap" FontSize="12" Foreground="#D9E0EA" />
                <TextBox x:Name="IpConditionsInput" MinHeight="38" Padding="8" Background="#111722" Foreground="#F4F6FA" BorderBrush="#3B485B" Margin="0,7,0,0" />
                <TextBlock Text="The allow or block choice above applies to every address in this list." TextWrapping="Wrap" FontSize="11" Foreground="#AAB4C3" Margin="0,5,0,0" />
            </StackPanel>
        </Expander>

        <StackPanel Grid.Row="6">
            <TextBlock x:Name="ErrorText" Foreground="#FF8E98" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DockPanel LastChildFill="False">
                <Button Content="Cancel" DockPanel.Dock="Right" IsCancel="True" Margin="10,0,0,0" />
                <Button Content="Add site" DockPanel.Dock="Right" IsDefault="True" Background="#C94150" BorderBrush="#E45562" Click="Add_Click" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
