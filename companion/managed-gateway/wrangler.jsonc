{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "killswitch-managed-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_POLICIES", "class_name": "DevicePolicy" },
      { "name": "REGISTRATION_LIMITS", "class_name": "RegistrationLimit" }
    ]
  },
  "exports": {
    "DevicePolicy": { "type": "durable-object", "storage": "sqlite" },
    "RegistrationLimit": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
